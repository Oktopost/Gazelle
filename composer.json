{
	"name": "oktopost/gazelle",
	"description": "Extensible cURL-based HTTP client with synchronous and concurrent requests, retries, decorators, and proxy support",
	"type": "library",
	"require": 
	{
		"php": ">=8.1",
		"oktopost/structura": "^3.0",
		"oktopost/objection": "^2.1",
		"oktopost/jsonencode": "^1.0",
		"oktopost/traitor": "^2.0",
		"ext-curl": "*"
	},
	"license": "MIT",
	"authors": 
	[
		{
			"name": "Alexey Puchkov",
			"email": "alexey.pkv@gmail.com"
		},
		{
			"name": "Roman Azarov",
			"email": "azarovroman@gmail.com"
		}
	],
	"require-dev": 
	{
		"phpunit/phpunit": "^10.5",
		"oktopost/unit-cover": "^1.0"
	},
	"autoload":
	{
		"psr-4": 
		{
			"Gazelle\\": "Source/"
		}
	},
	"autoload-dev":
	{
		"psr-4":
		{
			"Gazelle\\Tests\\": "Tests/"
		}
	},
	"scripts":
	{
		"test": "./vendor/phpunit/phpunit/phpunit --dont-report-useless-tests",
		"test-cover": "XDEBUG_MODE=coverage ./vendor/phpunit/phpunit/phpunit --dont-report-useless-tests --coverage-html ./build/cover --coverage-clover ./build/logs/clover.xml && ./vendor/oktopost/unit-cover/cover /build/logs/clover.xml 80"
	},
	"minimum-stability": "stable"
}
