{
	"name": "oktopost/gazelle",
	"type": "lib",
	"require": 
	{
		"unstable-cacao/structura": "^3.0",
		"oktopost/jsonencode": "^1.0",
		"unstable-cacao/traitor": "^2.0",
		"ext-curl": "*",
		"php": "^8.1"
	},
	"license": "MIT",
	"authors": 
	[
		{
			"name": "Alexey Puchkov",
			"email": "alexey.pkv@gmail.com"
		}
	],
	"require-dev": 
	{
		"unstable-cacao/web-core": "^1.0.0",
		"phpunit/phpunit": "^10.5",
		"unstable-cacao/web-server": "^1.0"
	},
	"autoload":
	{
		"psr-4": 
		{
			"Gazelle\\": "Source/"
		}
	},
	"autoload-dev":
	{
		"psr-4": 
		{
			"Gazelle\\": "Tests/"
		}
	},
	"scripts":
	{
		"test": "./vendor/phpunit/phpunit/phpunit --dont-report-useless-tests",
		"test-cover": "./vendor/phpunit/phpunit/phpunit --coverage-html .cover/"
	},
	"minimum-stability": "stable"
}
